<?xml version="1.0" encoding="utf-8"?>
<!-- 3D studio-lit background for the NoteMate icon: deep royal-blue base with a top-left key light glow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base diagonal 3D gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#10255A"
                android:endX="108"
                android:endY="108"
                android:startColor="#4C83F5"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#4C83F5"
                    android:offset="0.0" />
                <item
                    android:color="#2B5BC7"
                    android:offset="0.52" />
                <item
                    android:color="#10255A"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft top-left radial key light for 3D depth -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="26"
                android:centerY="22"
                android:gradientRadius="72"
                android:type="radial">
                <item
                    android:color="#557FB2FF"
                    android:offset="0.0" />
                <item
                    android:color="#00386CE2"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
