<?xml version="1.0" encoding="utf-8"?>
<!-- Frame animation: a page being written line by line, shown while there are no notes yet -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item
        android:drawable="@drawable/ic_page_0"
        android:duration="350" />
    <item
        android:drawable="@drawable/ic_page_1"
        android:duration="350" />
    <item
        android:drawable="@drawable/ic_page_2"
        android:duration="350" />
    <item
        android:drawable="@drawable/ic_page_3"
        android:duration="1000" />
</animation-list>
