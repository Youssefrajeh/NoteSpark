<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer for Android 12 and higher -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="notes.json" />
        <include domain="sharedpref" path="notemate_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="notes.json" />
        <include domain="sharedpref" path="notemate_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
