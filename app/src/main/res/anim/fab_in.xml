<?xml version="1.0" encoding="utf-8"?>
<!-- Tween animation (scale + rotate + alpha): the "New note" button spins in when the app opens -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="450"
    android:interpolator="@android:anim/overshoot_interpolator"
    android:startOffset="250">
    <scale
        android:fromXScale="0"
        android:fromYScale="0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
    <rotate
        android:fromDegrees="-90"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toDegrees="0" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
