<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.AboutActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Logo, app name and course -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_logo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/logo_description"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Widget.NoteMate.Caption"
                        android:text="@string/about_tagline" />

                    <TextView
                        style="@style/Widget.NoteMate.Caption"
                        android:text="@string/about_course" />
                </LinearLayout>
            </LinearLayout>

            <!-- What the app does -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.NoteMate.SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.NoteMate.CardTitle"
                        android:text="@string/about_what_title"
                        app:drawableStartCompat="@drawable/ic_info" />

                    <TextView
                        style="@style/Widget.NoteMate.Body"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/about_description" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Features -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.NoteMate.SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.NoteMate.CardTitle"
                        android:text="@string/about_features_title"
                        app:drawableStartCompat="@drawable/ic_sparkle" />

                    <TextView
                        android:id="@+id/text_features"
                        style="@style/Widget.NoteMate.Body"
                        android:lineSpacingExtra="6dp"
                        tools:text="• Scan notes" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- How to use it -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.NoteMate.SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.NoteMate.CardTitle"
                        android:text="@string/about_how_title"
                        app:drawableStartCompat="@drawable/ic_notes" />

                    <TextView
                        android:id="@+id/text_how_to"
                        style="@style/Widget.NoteMate.Body"
                        android:lineSpacingExtra="6dp"
                        tools:text="• Tap New note" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Group members: one row (item_member.xml) per member is added in AboutActivity -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.NoteMate.SectionCard">

                <LinearLayout
                    android:id="@+id/group_members"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.NoteMate.CardTitle"
                        android:text="@string/about_members_title"
                        app:drawableStartCompat="@drawable/ic_person" />

                    <TextView
                        style="@style/Widget.NoteMate.Caption"
                        android:layout_marginTop="4dp"
                        android:text="@string/about_group" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
